# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
DATABASE_URL=postgresql://diana:password@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-REQUIRED
JWT_EXPIRES_IN=7d
SESSION_EXPIRES_IN=24h

# Admin Account (for database seeding)
ADMIN_PASSWORD=ChangeMe123!

# Security
BCRYPT_ROUNDS=10
# Edge gateway rate limiting
# Rate задаётся вместе с единицей: 10/min, 5/s, 3600/h. Значение без
# единицы (просто 10) останавливает запуск edge с ошибкой — так лимит
# нельзя ослабить в 60 раз, перепутав секунды с минутами.
# Burst — количество токенов, единицы у него нет.
# Пустое значение означает «взять дефолт из кода»: дефолты заданы в
# loadRateLimitConfig() (backend-v2/cmd/edge/rate_limit_config.go) и
# описаны в docs/security/rate-limiting.md. Действующие значения edge
# печатает в лог при старте.

# вход и регистрация — дефолт 10/min, burst 5
EDGE_RATE_LIMIT_LOGIN_REGISTER_RATE=
EDGE_RATE_LIMIT_LOGIN_REGISTER_BURST=
# смена пароля и 2FA — дефолт 10/min, burst 5
EDGE_RATE_LIMIT_PASSWORD_2FA_RATE=
EDGE_RATE_LIMIT_PASSWORD_2FA_BURST=
# остальные auth-маршруты — дефолт 30/min, burst 10
EDGE_RATE_LIMIT_OTHER_AUTH_RATE=
EDGE_RATE_LIMIT_OTHER_AUTH_BURST=
# проверка занятости юзернейма — дефолт 2/s, burst 5
EDGE_RATE_LIMIT_USERNAME_CHECK_RATE=
EDGE_RATE_LIMIT_USERNAME_CHECK_BURST=
# запись сообщений — дефолт 5/s, burst 20
EDGE_RATE_LIMIT_MESSAGE_WRITE_RATE=
EDGE_RATE_LIMIT_MESSAGE_WRITE_BURST=
# чтение сообщений — дефолт 20/s, burst 40
EDGE_RATE_LIMIT_MESSAGE_READ_RATE=
EDGE_RATE_LIMIT_MESSAGE_READ_BURST=
# загрузка медиа — дефолт 60/min, burst 30
EDGE_RATE_LIMIT_MEDIA_UPLOAD_RATE=
EDGE_RATE_LIMIT_MEDIA_UPLOAD_BURST=
# звонки — дефолт 30/min, burst 15
EDGE_RATE_LIMIT_CALLS_RATE=
EDGE_RATE_LIMIT_CALLS_BURST=
# остальные API — дефолт 20/s, burst 40
EDGE_RATE_LIMIT_OTHER_API_RATE=
EDGE_RATE_LIMIT_OTHER_API_BURST=
# WebSocket handshake — дефолт 10/min, burst 20
EDGE_RATE_LIMIT_WEBSOCKET_RATE=
EDGE_RATE_LIMIT_WEBSOCKET_BURST=
# глобальный защитный лимит — дефолт 50/s, burst 100
EDGE_RATE_LIMIT_GLOBAL_RATE=
EDGE_RATE_LIMIT_GLOBAL_BURST=
# Media Storage
MEDIA_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,audio/ogg,application/pdf

# CraneApp Bot (Notifications & Support)
# Bot username: craneapp_bot
# Bot has verified badge and fixed password for admin access

# Notifications
FCM_SERVER_KEY=your-fcm-key
APNS_KEY_ID=your-apns-key-id

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://web.craneapp.ru,http://localhost:8080,http://localhost:5173
# Comma-separated trusted reverse proxy IPs or CIDR networks.
# Leave empty to ignore X-Forwarded-For and use RemoteAddr.
TRUSTED_PROXIES=

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

METERED_API_KEY=replace-with-metered-api-key
METERED_DOMAIN=craneapp.metered.live

# Backend v2 internal crypto service
CRYPTO_SIGNING_SECRET=replace-with-at-least-32-random-characters
CRYPTO_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
# Keep false through the compatibility rollout; enable only after every token
# issuer and validator is generation-aware (docs/deployment.md).
AUTH_LOGOUT_ALL_GENERATION_ENABLED=false
CRYPTO_TOKEN_TTL_SECONDS=900
