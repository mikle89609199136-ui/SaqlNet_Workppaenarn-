{
  "name": "craneapp-frontend",
  "version": "0.15.1",
  "description": "CraneApp Messenger - React/Vite client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src --ignore-path ../.prettierignore --ignore-path ../.gitignore",
    "format:check": "prettier --check src --ignore-path ../.prettierignore --ignore-path ../.gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check:cycles": "dpdm --no-tree --no-warning --tsconfig tsconfig.app.json --exit-code circular:1 --transform src/app/main.tsx",
    "api:types": "openapi-typescript ../backend-v2/contracts/openapi/api-v2.yaml -o src/types/api.generated.ts",
    "api:check": "tsc --noEmit --strict --skipLibCheck --target es2023 --moduleResolution bundler --module esnext src/types/userApiContract.node.test.ts src/types/mediaApiContract.node.test.ts && vitest run src/types/userApiContract.node.test.ts src/types/mediaApiContract.node.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@lexical/link": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@lexical/selection": "^0.51.0",
    "@lexical/utils": "^0.51.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-virtual": "^3.14.10",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.1",
    "jsqr": "^1.4.0",
    "lexical": "^0.51.0",
    "lucide-react": "^1.35.0",
    "ogg-opus-decoder": "^1.7.5",
    "opus-recorder": "^8.0.5",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.16.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@redocly/ajv": "8.11.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "dpdm": "^4.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.12.0",
    "js-yaml": "4.3.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
