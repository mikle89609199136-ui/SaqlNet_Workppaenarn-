{
  "name": "craneapp-frontend",
  "version": "1.0.0",
  "description": "CraneApp Messenger - React/Vite client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check:cycles": "dpdm --no-tree --no-warning --tsconfig tsconfig.app.json --exit-code circular:1 --transform src/main.tsx"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.4",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.16.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "dpdm": "^4.3.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
