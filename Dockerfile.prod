# Stage 1: Build frontend
FROM node:20-slim AS frontend
# WORKDIR двухуровневый: vite собирает в ../dist, то есть в /app/dist —
# именно оттуда финальный образ забирает результат.
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/vite.config.ts frontend/index.html frontend/mobile.html ./
RUN echo "css-bust-v8"
COPY frontend/src ./src
COPY frontend/public ./public
RUN npm run build

# Stage 2: Build Go services
FROM golang:1.26-alpine AS gobuilder
WORKDIR /src
COPY backend-v2/go.mod backend-v2/go.sum ./
RUN go mod download
COPY backend-v2/internal ./internal
COPY backend-v2/contracts ./contracts
COPY backend-v2/cmd ./cmd
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /binaries/auth    ./cmd/auth && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /binaries/user    ./cmd/user && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /binaries/chat    ./cmd/chat && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /binaries/media   ./cmd/media && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /binaries/edge    ./cmd/edge && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /binaries/migrate ./cmd/migrate && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /binaries/migrate-legacy ./cmd/migrate-legacy

# Stage 3: Build crypto-rust
FROM rust:1.94-slim AS cryptobuilder
WORKDIR /src
COPY server/crypto-rust/Cargo.toml server/crypto-rust/Cargo.lock ./
COPY server/crypto-rust/src ./src
RUN cargo build --release --locked

# Stage 4: Download NATS server and MinIO
FROM debian:bookworm-slim AS infra-download

ARG NATS_VERSION=2.10.22
ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
    "https://github.com/nats-io/nats-server/releases/download/v${NATS_VERSION}/nats-server-v${NATS_VERSION}-linux-amd64.tar.gz" \
    | tar -xz \
        --strip-components=1 \
        -C /usr/local/bin \
        "nats-server-v${NATS_VERSION}-linux-amd64/nats-server"

RUN curl -fsSL \
    "https://dl.min.io/server/minio/release/linux-amd64/archive/minio.${MINIO_VERSION}" \
    -o /usr/local/bin/minio \
    && chmod +x /usr/local/bin/minio

# Stage 5: Final image
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    supervisor \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=infra-download /usr/local/bin/nats-server /usr/local/bin/nats-server
COPY --from=infra-download /usr/local/bin/minio /usr/local/bin/minio

RUN echo "gobins-v2"
COPY --from=gobuilder   /binaries/auth     /usr/local/bin/auth
COPY --from=gobuilder   /binaries/user     /usr/local/bin/user
COPY --from=gobuilder   /binaries/chat     /usr/local/bin/chat
COPY --from=gobuilder   /binaries/media    /usr/local/bin/media
COPY --from=gobuilder   /binaries/edge     /usr/local/bin/edge
COPY --from=gobuilder   /binaries/migrate  /usr/local/bin/migrate
COPY --from=gobuilder   /binaries/migrate-legacy /usr/local/bin/migrate-legacy
COPY --from=cryptobuilder /src/target/release/crypto-rust /usr/local/bin/crypto-rust
COPY --from=frontend    /app/dist     /dist
COPY supervisord.conf      /etc/supervisor/conf.d/craneapp.conf
COPY backend-v2/migrations /app/migrations
COPY docker-entrypoint.sh  /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV RUN_LEGACY_MIGRATION=true
ENV LEGACY_UPLOADS_DIR=/data/legacy-uploads

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
