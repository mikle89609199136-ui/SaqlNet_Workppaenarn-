# Add real values to Vercel Production AND Preview. Never commit them.
PORT=80
CRANE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/craneapp?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379
NATS_URL=tls://USER:PASSWORD@HOST:4222
# Exact frontend origin(s), including the preview URL when testing previews.
ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
CRYPTO_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CRYPTO_ENCRYPTION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_LOGOUT_ALL_GENERATION_ENABLED=false
# S3-compatible endpoint with path-style bucket access.
MINIO_ENDPOINT=https://YOUR-S3-ENDPOINT
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_REGION=us-east-1
MEDIA_BUCKET=crane-media
MAX_FILE_SIZE=104857600
# Optional Web Push and TURN credentials:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@YOUR-DOMAIN
# METERED_API_KEY=
# METERED_DOMAIN=

# Object storage: absent/minio retains the existing S3 provider.
# For Blob, create a PRIVATE store and connect its read-write token.
STORAGE_PROVIDER=minio
BLOB_READ_WRITE_TOKEN=
# vercel_blob does not require MINIO_*; MEDIA_BUCKET is a Blob path namespace.
